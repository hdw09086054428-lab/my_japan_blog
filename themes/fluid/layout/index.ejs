<%- partial('_partials/header/banner') %>
<%
// バナー画像の設定を確実に読み込む
page.banner_img = theme.index.banner_img || '/img/banner_shenzhen.jpg'
page.banner_img_height = theme.index.banner_img_height || 80
page.banner_mask_alpha = theme.index.banner_mask_alpha || 0.2

if (theme.index.slogan.enable) {
  page.subtitle = theme.index.slogan.text || config.subtitle || ''
}
%>

<h1 style="display: none"><%= config.title %></h1>

<% page.posts.each(function (post) { %>
  <div class="row mx-auto index-card">
    <% var post_url = url_for(post.path), index_img = post.index_img || theme.post.default_index_img %>

    <% if (index_img) { %>
      <div class="col-12 col-md-4 m-auto index-img">
        <a href="<%= post_url %>">
          <img src="<%= url_for(index_img) %>" alt="<%= post.title %>">
        </a>
      </div>
    <% } %>

    <article class="col-12 col-md-<%= index_img ? '8' : '12' %> mx-auto index-info">
      <h2 class="index-header">
        <% if (theme.index.post_sticky && theme.index.post_sticky.enable && post.sticky > 0) { %>
          <i class="index-pin <%= theme.index.post_sticky.icon %>"></i>
        <% } %>
        <a href="<%= post_url %>" class="post-title-link">
          <% var titles = post.title.split('||') %>
          <span class="lang-ja"><%= titles[0].trim() %></span>
          <% if (titles.length > 1) { %>
            <span class="lang-zh" style="display:none;"><%= titles[1].trim() %></span>
          <% } else { %>
            <span class="lang-zh" style="display:none;"><%= titles[0].trim() %></span>
          <% } %>
        </a>
      </h2>

      <% var excerpt = post.description || post.excerpt || (theme.index.auto_excerpt.enable && post.content) || '' %>
      <a class="index-excerpt" href="<%= post_url %>">
        <div class="index-excerpt-text">
          <% var excerpts = strip_html(excerpt).split('||') %>
          <span class="lang-ja"><%- excerpts[0].trim().substring(0, 200) %></span>
          <% if (excerpts.length > 1) { %>
            <span class="lang-zh" style="display:none;"><%- excerpts[1].trim().substring(0, 200) %></span>
          <% } else { %>
            <span class="lang-zh" style="display:none;"><%- excerpts[0].trim().substring(0, 200) %></span>
          <% } %>
        </div>
      </a>

      <div class="index-btm post-metas">
        <div class="post-meta mr-3">
          <i class="iconfont icon-date"></i>
          <%- date(post.date, config.date_format) %>
        </div>
        <% if (post.categories && post.categories.length > 0) { %>
          <div class="post-meta mr-3">
            <i class="iconfont icon-category"></i>
            <span class="category-text">
              <%- partial('_partials/category-chains', { categories: post.categories, limit: 1 }) %>
            </span>
          </div>
        <% } %>
      </div>
    </article>
  </div>
<% }) %>

<%- partial('_partials/paginator') %>
