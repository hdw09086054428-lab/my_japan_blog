<img
  src="<%= page.cover_jp || theme.post.banner_img %>"
  data-jp="<%= page.cover_jp || theme.post.banner_img %>"
  data-cn="<%= page.cover_cn || theme.post.banner_img_cn || theme.post.banner_img %>"
  id="dynamic-banner"
  alt="cover"
  style="width:100%;height:100%;object-fit:cover;"
/>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const lang = localStorage.getItem('site-lang') || 'ja';
  const img = document.getElementById('dynamic-banner');
  if (img) {
    img.src = lang === 'ja' ? img.dataset.jp : img.dataset.cn;
  }
});
</script>
